# ElectraKart Environment Variables Example (.env.example)
NODE_ENV=development
API_PORT=5000
API_HOST=0.0.0.0
DATABASE_URL=pglite://./data/pgdata
JWT_SECRET=dev-electrakart-secret-key-384918294021
JWT_EXPIRES_IN=86400
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=26214400

# Payment Gateway Configuration
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# OCR Provider Configuration: 'mock' (dev default), 'disabled', 'google_document_ai', or 'aws_textract'.
# In production, use 'disabled' unless real cloud credentials are provided.
OCR_PROVIDER=mock
GOOGLE_DOC_AI_PROJECT_ID=
GOOGLE_DOC_AI_LOCATION=us
GOOGLE_DOC_AI_PROCESSOR_ID=
AWS_TEXTRACT_REGION=ap-south-1
AWS_TEXTRACT_ACCESS_KEY_ID=
AWS_TEXTRACT_SECRET_ACCESS_KEY=

# Maps & Distance Provider Configuration: 'mock' (dev default), 'disabled', 'google_maps', or 'mapbox'.
# In production, use 'disabled' unless real Maps credentials are provided.
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Notification & Communication Architecture
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=alerts@electrakart.com
EMAIL_WEBHOOK_SECRET=
SMS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_WEBHOOK_SECRET=
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta_whatsapp
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

