# ElectraKart Backend Environment Configuration

# Application
NODE_ENV=development
API_PORT=5000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Security & Authentication
JWT_SECRET=super-secret-electrakart-production-jwt-key-change-in-prod
JWT_EXPIRES_IN=86400

# Database Configuration
# Options:
# 1. Native / Remote PostgreSQL: postgresql://postgres:password@localhost:5432/electrakart
# 2. Zero-Config Embedded PostgreSQL: pglite://./data/pgdata (Default for local development)
DATABASE_URL=pglite://./data/pgdata
