# ElectraKart Production Environment Example (.env.production.example)
NODE_ENV=production
API_PORT=5000
API_HOST=0.0.0.0
DATABASE_URL=postgresql://electrakart_user:SECURE_PASSWORD@pg-cluster.internal:5432/electrakart_prod?sslmode=require
JWT_SECRET=GENERATED_64_CHAR_HIGH_ENTROPY_CRYPTOGRAPHIC_KEY_STRING_HERE
JWT_EXPIRES_IN=86400
CORS_ORIGIN=https://electrakart.com,https://app.electrakart.com
LOG_LEVEL=info
DB_POOL_MAX=25
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=26214400

# Payment Gateway Configuration (Production: 'razorpay' or 'cashfree'; 'mock' will fail startup)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_live_secret
RAZORPAY_WEBHOOK_SECRET=your_actual_live_webhook_secret
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# OCR Provider Configuration (Production: 'google_document_ai' or 'aws_textract'; 'mock' will fail startup)
OCR_PROVIDER=google_document_ai
GOOGLE_DOC_AI_PROJECT_ID=electrakart-prod-cloud
GOOGLE_DOC_AI_LOCATION=us
GOOGLE_DOC_AI_PROCESSOR_ID=prod_doc_ai_processor_id_here
AWS_TEXTRACT_REGION=ap-south-1
AWS_TEXTRACT_ACCESS_KEY_ID=
AWS_TEXTRACT_SECRET_ACCESS_KEY=

# Maps & Distance Provider Configuration (Production: 'google_maps' or 'mapbox'; 'mock' will fail startup)
MAPS_PROVIDER=google_maps
GOOGLE_MAPS_API_KEY=AIzaSy_YOUR_LIVE_PRODUCTION_GOOGLE_MAPS_KEY_HERE
MAPBOX_ACCESS_TOKEN=
