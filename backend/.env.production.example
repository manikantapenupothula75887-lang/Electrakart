# ElectraKart Production Deployment Environment Template
# DO NOT COMMIT REAL SECRETS. Configure these in your production host/container environment.
NODE_ENV=production
API_PORT=5000
API_HOST=0.0.0.0

# Real PostgreSQL connection string required in production (PGlite is rejected)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/electrakart_prod?sslmode=require

# Minimum 32-character high-entropy secret required (startup fails if missing or default)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_PRODUCTION_SECRET
JWT_EXPIRES_IN=86400

# Allowed frontend origins (comma-separated, wildcard '*' strictly rejected for authenticated API)
CORS_ORIGIN=https://electrakart.com,https://app.electrakart.com

LOG_LEVEL=info
DB_POOL_MAX=25
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=1048576

# Payment Gateway Configuration (Production: 'razorpay' or 'cashfree'; 'mock' is strictly rejected)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=YOUR_LIVE_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_LIVE_RAZORPAY_WEBHOOK_SECRET
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# OCR Provider Configuration (Production: 'google_document_ai' or 'aws_textract'; 'mock' is strictly rejected)
OCR_PROVIDER=google_document_ai
GOOGLE_DOC_AI_PROJECT_ID=your-gcp-project-id
GOOGLE_DOC_AI_LOCATION=us
GOOGLE_DOC_AI_PROCESSOR_ID=your-doc-ai-processor-id
# Alternatively, for AWS Textract:
# OCR_PROVIDER=aws_textract
# AWS_TEXTRACT_REGION=ap-south-1
# AWS_TEXTRACT_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
# AWS_TEXTRACT_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
BODY_LIMIT_BYTES=26214400
