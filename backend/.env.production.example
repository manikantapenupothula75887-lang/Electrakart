# ElectraKart Production Environment Example (.env.production.example)
NODE_ENV=production
API_PORT=5000
API_HOST=0.0.0.0
DATABASE_URL=postgresql://electrakart_user:SECURE_PASSWORD@pg-cluster.internal:5432/electrakart_prod?sslmode=require
JWT_SECRET=GENERATED_64_CHAR_HIGH_ENTROPY_CRYPTOGRAPHIC_KEY_STRING_HERE
JWT_EXPIRES_IN=86400
CORS_ORIGIN=https://electrakart.com,https://app.electrakart.com
LOG_LEVEL=info
DB_POOL_MAX=25
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=26214400

# Payment Gateway Configuration (Production: 'razorpay' or 'cashfree'; 'mock' will fail startup)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_live_secret
RAZORPAY_WEBHOOK_SECRET=your_actual_live_webhook_secret
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# OCR Provider Configuration: 'disabled' (production default/optional), 'google_document_ai', or 'aws_textract'.
# In production, 'mock' is strictly prohibited. Set OCR_PROVIDER=disabled to run without cloud OCR.
# Real OCR can later be enabled simply by setting OCR_PROVIDER=google_document_ai (with project & processor IDs)
# or OCR_PROVIDER=aws_textract (with AWS credentials).
OCR_PROVIDER=disabled
GOOGLE_DOC_AI_PROJECT_ID=
GOOGLE_DOC_AI_LOCATION=us
GOOGLE_DOC_AI_PROCESSOR_ID=
AWS_TEXTRACT_REGION=ap-south-1
AWS_TEXTRACT_ACCESS_KEY_ID=
AWS_TEXTRACT_SECRET_ACCESS_KEY=

# Maps & Distance Provider Configuration: 'disabled' (production default/optional), 'google_maps', or 'mapbox'.
# In production, 'mock' is strictly prohibited. Set MAPS_PROVIDER=disabled to run using accurate geodesic Haversine distance
# without external Google Maps / Mapbox API credentials.
# Real routing can later be enabled simply by setting MAPS_PROVIDER=google_maps (with GOOGLE_MAPS_API_KEY)
# or MAPS_PROVIDER=mapbox (with MAPBOX_ACCESS_TOKEN).
MAPS_PROVIDER=disabled
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Notification & Communication Architecture (Production: real credentials required when channels enabled; 'mock' will fail startup)
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_live_your_actual_resend_api_key_here
EMAIL_FROM=ElectraKart Alerts <alerts@electrakart.com>
EMAIL_WEBHOOK_SECRET=your_resend_webhook_signing_secret
SMS_ENABLED=true
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_your_live_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_live_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
SMS_WEBHOOK_SECRET=your_twilio_webhook_signing_secret
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta_whatsapp
WHATSAPP_API_TOKEN=EAAG_your_live_meta_whatsapp_cloud_token_here
WHATSAPP_PHONE_NUMBER_ID=109283746592837
WHATSAPP_WEBHOOK_SECRET=your_meta_whatsapp_verify_token_here

